{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "rfmMatrix",
  "position": {
    "x": 800,
    "y": 560,
    "z": 3,
    "height": 500,
    "width": 1100,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "R"
                }
              },
              "queryRef": "Customers.R",
              "nativeQueryRef": "R",
              "active": true,
              "displayName": "R score",
              "format": "0"
            }
          ]
        },
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "F"
                }
              },
              "queryRef": "Customers.F",
              "nativeQueryRef": "F",
              "active": true,
              "displayName": "F score",
              "format": "0"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Customer Count"
                }
              },
              "queryRef": "_Measures.Customer Count",
              "nativeQueryRef": "Customer Count",
              "displayName": "Customers"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Customer count by Frequency (rows) and Recency (columns) score'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}