{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "segmentTable",
  "position": {
    "x": 800,
    "y": 70,
    "z": 2,
    "height": 470,
    "width": 1100,
    "tabOrder": 2
  },
  "visual": {
    "visualType": "tableEx",
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "Segment"
                }
              },
              "queryRef": "Customers.Segment",
              "nativeQueryRef": "Segment"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Customer Count"
                }
              },
              "queryRef": "_Measures.Customer Count",
              "nativeQueryRef": "Customer Count",
              "displayName": "Customers"
            },
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "Customers"
                        }
                      },
                      "Property": "Recency"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(Customers.Recency)",
              "nativeQueryRef": "Average of Avg(Customers.Recency)",
              "displayName": "Avg recency (days)"
            },
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "Customers"
                        }
                      },
                      "Property": "Frequency"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(Customers.Frequency)",
              "nativeQueryRef": "Average of Avg(Customers.Frequency)",
              "displayName": "Avg orders"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Lifetime Sales"
                }
              },
              "queryRef": "_Measures.Lifetime Sales",
              "nativeQueryRef": "Lifetime Sales"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "% Customers"
                }
              },
              "queryRef": "_Measures.% Customers",
              "nativeQueryRef": "% Customers"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "% Lifetime Sales"
                }
              },
              "queryRef": "_Measures.% Lifetime Sales",
              "nativeQueryRef": "% Lifetime Sales"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Customer Count"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Segment summary'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}