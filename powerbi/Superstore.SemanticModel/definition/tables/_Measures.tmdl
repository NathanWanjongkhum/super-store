table _Measures
	lineageTag: def2e814-0019-44e3-9a22-8f1b741e34f3

	measure 'Sales Total' = SUM ( Orders[Sales] )
		formatString: \$#,0
		displayFolder: Base totals
		lineageTag: d6a18c98-8709-492b-91fe-629bd8b09102

	/// Time window
	measure 'Window End' = EOMONTH ( SELECTEDVALUE ( 'As Of'[As Of Month], DATE ( 2014, 12, 1 ) ), 0 )
		formatString: d mmm yyyy
		displayFolder: Time window
		lineageTag: 09823942-c424-4171-8858-0dd0520d698e

	measure 'Window Start' =
			VAR e = [Window End]
			RETURN SWITCH ( SELECTEDVALUE ( Period[Period], "Year to date" ),
			    "Month to date", DATE ( YEAR ( e ), MONTH ( e ), 1 ),
			    "Quarter to date", DATE ( YEAR ( e ), 3 * ROUNDUP ( MONTH ( e ) / 3, 0 ) - 2, 1 ),
			    "Year to date", DATE ( YEAR ( e ), 1, 1 ),
			    "Trailing 12 months", EDATE ( DATE ( YEAR ( e ), MONTH ( e ), 1 ), -11 ) )
		formatString: d mmm yyyy
		displayFolder: Time window
		lineageTag: 1e82e0ea-a7de-42ed-99ae-6e8266171fd9

	measure 'Period Caption' =
			VAR s = [Window Start]
			VAR e = [Window End]
			RETURN SELECTEDVALUE ( Period[Short], "YTD" ) & " · "
			    & FORMAT ( s, IF ( YEAR ( s ) = YEAR ( e ), "d mmm", "d mmm yyyy" ) )
			    & " – " & FORMAT ( e, "d mmm yyyy" ) & " vs last year"
		displayFolder: Time window
		lineageTag: 2f5d17c6-b660-4b9f-87de-490d2fa9ae18

	measure 'Profit Total' = SUM ( Orders[Profit] )
		formatString: \$#,0
		displayFolder: Base totals
		lineageTag: 33e6674d-195b-43b9-a02b-dabd18f0aa60

	measure Sales = CALCULATE ( [Sales Total], DATESBETWEEN ( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: \$#,0
		displayFolder: Period KPIs
		lineageTag: c9ab65ce-e4c2-44f7-82a1-4a30793ab6c8

	measure Profit = CALCULATE ( [Profit Total], DATESBETWEEN ( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: \$#,0
		displayFolder: Period KPIs
		lineageTag: 329e5219-b859-4584-bb76-de9e257d60a0

	measure 'Profit Margin' = DIVIDE ( [Profit], [Sales] ) * 100
		formatString: 0.0"%"
		displayFolder: Period KPIs
		lineageTag: 117241b9-c2f6-4777-b786-b8effc87cdc9

	measure 'Avg Discount' =
			CALCULATE ( AVERAGE ( Orders[Discount] ),
			    DATESBETWEEN ( 'Date'[Date], [Window Start], [Window End] ) ) * 100
		formatString: 0.0"%"
		displayFolder: Period KPIs
		lineageTag: 5051ec23-7956-46da-9e4f-66653e5f8389

	measure 'Sales LY' =
			CALCULATE ( [Sales Total],
			    DATESBETWEEN ( 'Date'[Date], EDATE ( [Window Start], -12 ), EDATE ( [Window End], -12 ) ) )
		formatString: \$#,0
		displayFolder: Period KPIs
		lineageTag: c4b84b81-cf78-4d30-9dfc-96dc9f268653

	measure 'Profit LY' =
			CALCULATE ( [Profit Total],
			    DATESBETWEEN ( 'Date'[Date], EDATE ( [Window Start], -12 ), EDATE ( [Window End], -12 ) ) )
		formatString: \$#,0
		displayFolder: Period KPIs
		lineageTag: 1adb2f31-6832-48cb-8e04-1ca0aa8bff42

	measure 'Profit Margin LY' = DIVIDE ( [Profit LY], [Sales LY] ) * 100
		formatString: 0.0"%"
		displayFolder: Period KPIs
		lineageTag: 4fcab87b-ebc1-4009-a45f-15ed7481796d

	measure 'Avg Discount LY' =
			CALCULATE ( AVERAGE ( Orders[Discount] ),
			    DATESBETWEEN ( 'Date'[Date], EDATE ( [Window Start], -12 ), EDATE ( [Window End], -12 ) ) ) * 100
		formatString: 0.0"%"
		displayFolder: Period KPIs
		lineageTag: 3dd8b8ab-8ccb-49d3-b7fd-856cc5183966

	measure 'Growth %' = IF ( [Sales LY] <> 0, ( DIVIDE ( [Sales], [Sales LY] ) - 1 ) * 100 )
		formatString: 0.0"%"
		displayFolder: Period KPIs
		lineageTag: e3410cac-92c5-4789-a124-51e6a2b67ec9

	measure '% of Sales' = DIVIDE ( [Sales], CALCULATE ( [Sales], ALLSELECTED () ) ) * 100
		formatString: 0.0"%"
		displayFolder: Period KPIs
		lineageTag: 50b6e171-fa5f-437e-92d0-d104e1da9b0f

	/// Fixed 12-month windows ending on the as-of date; ignores the Period selector
	measure 'Customer Retention' =
			VAR e = [Window End]
			VAR prior = CALCULATETABLE ( VALUES ( Orders[Customer ID] ), REMOVEFILTERS ( 'Date' ),
			    Orders[Order Week] > EDATE ( e, -24 ), Orders[Order Week] <= EDATE ( e, -12 ) )
			VAR curr = CALCULATETABLE ( VALUES ( Orders[Customer ID] ), REMOVEFILTERS ( 'Date' ),
			    Orders[Order Week] > EDATE ( e, -12 ), Orders[Order Week] <= e )
			RETURN DIVIDE ( COUNTROWS ( INTERSECT ( prior, curr ) ), COUNTROWS ( prior ) ) * 100
		formatString: 0.0"%"
		displayFolder: Customer KPIs
		lineageTag: 24fed2dd-4dc1-482a-87f0-bb7569bf9067

	measure 'Customer Retention LY' =
			VAR e = EDATE ( [Window End], -12 )
			VAR prior = CALCULATETABLE ( VALUES ( Orders[Customer ID] ), REMOVEFILTERS ( 'Date' ),
			    Orders[Order Week] > EDATE ( e, -24 ), Orders[Order Week] <= EDATE ( e, -12 ) )
			VAR curr = CALCULATETABLE ( VALUES ( Orders[Customer ID] ), REMOVEFILTERS ( 'Date' ),
			    Orders[Order Week] > EDATE ( e, -12 ), Orders[Order Week] <= e )
			RETURN DIVIDE ( COUNTROWS ( INTERSECT ( prior, curr ) ), COUNTROWS ( prior ) ) * 100
		formatString: 0.0"%"
		displayFolder: Customer KPIs
		lineageTag: ec7ce8df-d7f8-4513-9ca8-9ab6fcf7898a

	measure 'Revenue at Risk' =
			DIVIDE ( CALCULATE ( SUM ( Customers[Monetary] ), Customers[Segment] IN { "At Risk", "Can't Lose" } ),
			         CALCULATE ( SUM ( Customers[Monetary] ), REMOVEFILTERS ( Customers ) ) ) * 100
		formatString: 0.0"%"
		displayFolder: Customer KPIs
		lineageTag: 2f0bf31d-7585-4122-9e66-4f07660e3077

	/// One set of measures for all six KPI cards, driven by the KPI table
	measure 'KPI Value' =
			SWITCH ( SELECTEDVALUE ( 'KPI'[KPI] ),
			    "Sales", [Sales], "Profit", [Profit], "Profit Margin", [Profit Margin],
			    "Avg Discount", [Avg Discount], "Customer Retention", [Customer Retention],
			    "Revenue at Risk", [Revenue at Risk] )
		displayFolder: KPI cards
		lineageTag: 6cf738a1-6dc6-4adf-97e7-1264daacd414

		formatStringDefinition = IF ( SELECTEDVALUE ( 'KPI'[Kind] ) = "pct", "0.0""%""", "$#,0" )

	measure 'KPI LY' =
			SWITCH ( SELECTEDVALUE ( 'KPI'[KPI] ),
			    "Sales", [Sales LY], "Profit", [Profit LY], "Profit Margin", [Profit Margin LY],
			    "Avg Discount", [Avg Discount LY], "Customer Retention", [Customer Retention LY] )
		displayFolder: KPI cards
		lineageTag: 520f5841-c10a-4d4f-97e9-1c3f27750e40

	measure 'KPI Target' =
			SWITCH ( SELECTEDVALUE ( 'KPI'[KPI] ),
			    "Sales", [Sales LY] * ( 1 + [Sales Growth Target Value] / 100 ),
			    "Profit", [Profit LY] * ( 1 + [Sales Growth Target Value] / 100 ),  -- profit uses the sales growth target
			    "Profit Margin", [Profit Margin Target Value],
			    "Avg Discount", [Max Discount Target Value],
			    "Customer Retention", [Retention Target Value],
			    "Revenue at Risk", [Max Revenue at Risk Target Value] )
		displayFolder: KPI cards
		lineageTag: 5977c5af-81e3-4b39-8a70-5efdb2f898c1

	measure 'KPI Status' =
			VAR v = [KPI Value]
			VAR t = [KPI Target]
			VAR ratio = IF ( SELECTEDVALUE ( 'KPI'[Higher Is Better] ), DIVIDE ( v, t ), DIVIDE ( t, v ) )
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( v ) || v = 0 || ISBLANK ( t ), "No target",
			    ratio >= 1, "On track",
			    ratio >= 0.9, "Monitor",
			    "Off track" )
		displayFolder: KPI cards
		lineageTag: 6efd4a95-9277-4c52-8325-02dd62784082

	measure 'KPI Color' =
			SWITCH ( [KPI Status],
			    "On track", "#2e7d32", "Monitor", "#f9a825", "Off track", "#c62828", "#9e9e9e" )
		displayFolder: KPI cards
		lineageTag: 4c67bdbc-93ae-43df-8e35-498a2c981186

	measure 'KPI YoY' =
			VAR v = [KPI Value]
			VAR ly = [KPI LY]
			RETURN IF ( NOT ISBLANK ( v ) && NOT ISBLANK ( ly ),
			    IF ( SELECTEDVALUE ( 'KPI'[Kind] ) = "pct",
			        FORMAT ( v - ly, "+0.0;-0.0" ) & " pts",
			        FORMAT ( DIVIDE ( v, ly ) - 1, "+0.0%;-0.0%" ) ) & " YoY" )
		displayFolder: KPI cards
		lineageTag: fdea520f-cb43-47ab-bd25-ce779d7f5e29

	measure 'KPI Target Text' =
			VAR t = [KPI Target]
			VAR sign = IF ( SELECTEDVALUE ( 'KPI'[Higher Is Better] ), "≥ ", "≤ " )
			RETURN IF ( ISBLANK ( t ), "No target", sign &
			    IF ( SELECTEDVALUE ( 'KPI'[Kind] ) = "pct", FORMAT ( t, "0.0" ) & "%",
			    IF ( ABS ( t ) >= 1e6, FORMAT ( t / 1e6, "$0.00" ) & "M",
			    IF ( ABS ( t ) >= 1e3, FORMAT ( t / 1e3, "$0.0" ) & "K", FORMAT ( t, "$#,0" ) ) ) ) )
		displayFolder: KPI cards
		lineageTag: 05f33172-3116-4ee1-9e1a-5d57c30e01af

	/// Market / sub-category margin, always scored against the margin target
	measure 'Margin Status' =
			VAR m = [Profit Margin]
			VAR ratio = DIVIDE ( m, [Profit Margin Target Value] )
			RETURN SWITCH ( TRUE (), ISBLANK ( m ) || m = 0, "No target",
			    ratio >= 1, "On track", ratio >= 0.9, "Monitor", "Off track" )
		displayFolder: Margin
		lineageTag: ee0c0915-d77f-4c7f-b530-cbcdd8a2a5cb

	measure 'Margin Color' =
			SWITCH ( [Margin Status],
			    "On track", "#2e7d32", "Monitor", "#f9a825", "Off track", "#c62828", "#9e9e9e" )
		displayFolder: Margin
		lineageTag: 4a783287-c1e2-4e8c-92a8-d8ff4e6b01fc

	measure 'Profit Gap' = [Profit] - [Profit Margin Target Value] / 100 * [Sales]
		formatString: \$#,0
		displayFolder: Margin
		lineageTag: 894f9ef1-3991-47f3-a61a-95edcd8492e7

	measure 'In Last 12 Months' =
			VAR m = MAX ( 'Date'[Month] )
			VAR e = [Window End]
			RETURN IF ( m > EDATE ( e, -12 ) && m <= e, 1 )
		formatString: 0
		displayFolder: Trend charts
		lineageTag: ef8f3fa6-e0a8-4431-a842-24c77030bde8

	measure 'Sales Last Year (monthly)' = CALCULATE ( [Sales Total], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0
		displayFolder: Trend charts
		lineageTag: c4f3f68c-7274-4a99-9918-f29a6dbcc28e

	measure 'Margin 3M Rolling' =
			VAR d = DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -3, MONTH )
			RETURN DIVIDE ( CALCULATE ( [Profit Total], d ), CALCULATE ( [Sales Total], d ) ) * 100
		formatString: 0.0"%"
		displayFolder: Trend charts
		lineageTag: 0d239b85-14fe-4ebf-86d7-a8a1fb571d87

	/// Next Monday after the window ends
	measure 'Review Date' = [Window End] + 8 - WEEKDAY ( [Window End], 2 )
		formatString: ddd d mmm yyyy
		displayFolder: Action items
		lineageTag: 7d641b09-4e10-424b-897a-d4a73240ff34

	/// Off-track items first, then biggest $ impact (sort descending)
	measure 'KPI Priority' =
			VAR gap = IF ( SELECTEDVALUE ( 'KPI'[Higher Is Better] ), [KPI Target] - [KPI Value], [KPI Value] - [KPI Target] )
			VAR impact = IF ( SELECTEDVALUE ( 'KPI'[Kind] ) = "pct", gap / 100 * [Sales], gap )
			RETURN IF ( [KPI Status] = "Off track", 1e12, 0 ) + impact
		formatString: #,0
		displayFolder: Action items
		lineageTag: a6b88bfc-6abb-4f73-a23e-386572eb6662

	measure 'Data Through' = "Data through " & FORMAT ( CALCULATE ( MAX ( Orders[Order Week] ), REMOVEFILTERS () ), "d mmm yyyy" )
		displayFolder: Action items
		lineageTag: 584f44ae-c17d-4f73-b01c-b8d699ca15a9

	measure 'Customer Count' = COUNTROWS ( Customers )
		formatString: #,0
		displayFolder: Customers (RFM)
		lineageTag: 031167d4-9f8f-45f6-9c20-1f9edbce8403

	measure '% Customers' = DIVIDE ( [Customer Count], CALCULATE ( [Customer Count], ALL ( Customers[Segment] ) ) ) * 100
		formatString: 0.0"%"
		displayFolder: Customers (RFM)
		lineageTag: 08f11707-69c5-4f28-a707-97a7cd8c04bd

	measure 'Lifetime Sales' = SUM ( Customers[Monetary] )
		formatString: \$#,0
		displayFolder: Customers (RFM)
		lineageTag: 8541065e-068d-49af-9be7-1cec7ba78063

	measure '% Lifetime Sales' = DIVIDE ( [Lifetime Sales], CALCULATE ( [Lifetime Sales], ALL ( Customers[Segment] ) ) ) * 100
		formatString: 0.0"%"
		displayFolder: Customers (RFM)
		lineageTag: d6cfff05-5cd1-42f7-a3f7-d2d5afa8e47e

	measure 'Segment Color' = IF ( SELECTEDVALUE ( Customers[Segment] ) IN { "At Risk", "Can't Lose" }, "#c62828", "#9e9e9e" )
		displayFolder: Customers (RFM)
		lineageTag: 70cf6641-d9db-411b-9319-01e9bd4e2c41

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

